# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional GitHub Notepad Database Sync (server-side, never expose tokens to UI)
# GITHUB_TOKEN: Personal Access Token with repo contents read/write scope for online saving
GITHUB_TOKEN=""
# GITHUB_REPO: Default repository in "owner/repo" format (e.g., "username/wordfun-db")
GITHUB_REPO=""
# GITHUB_BRANCH: Target branch name (defaults to "main")
GITHUB_BRANCH="main"
# GITHUB_DB_PATH: Notepad database file path inside the repo (defaults to "wordfun-database.txt")
GITHUB_DB_PATH="wordfun-database.txt"

# Optional GitHub 3P OAuth App credentials (for interactive "Connect GitHub" popup login)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

